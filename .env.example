# Environment variables for ValorBOM tests
# Copy this file to .env and fill in the values for live tests

# Base URLs
JIRA_BASE_URL=https://jira.example.com
ONSHAPE_BASE_URL=https://cad.onshape.com

# Project settings
PROJECT_KEY=YOUR_PROJECT_KEY

# API keys and credentials
SECRET_KEY=YOUR_ONSHAPE_SECRET_KEY
API_KEY=YOUR_ONSHAPE_API_KEY
JIRA_KEY=YOUR_JIRA_API_KEY
ONSHAPE_TEAM_ID=YOUR_ONSHAPE_TEAM_ID
SEASON_ID=25S

# Test data for live tests
# These are optional but recommended for more thorough testing
TEST_DOCUMENT_ID=YOUR_TEST_DOCUMENT_ID
TEST_WORKSPACE_ID=YOUR_TEST_WORKSPACE_ID
TEST_ELEMENT_ID=YOUR_TEST_ELEMENT_ID

# Enable live tests (this can also be set via command line)
# ENABLE_LIVE_TESTS=true