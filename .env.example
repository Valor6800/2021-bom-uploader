# ValorBOM Environment Variables
# Copy this file to .env and fill in your values.
# (Legacy aliases in parentheses are still accepted for backward compatibility.)

PORT=3000

# How different two versions of a part's shape may be (relative, volume / surface
# area / mass / inertia) and still count as the same part when deciding whether
# a Part needs a new Revision. Default 0.0001 (0.01%). Loosen it if unchanged
# parts are getting new Revisions; tighten it if real edits are being missed.
# PART_DIFF_TOLERANCE=0.0001
# Where cut versions' BOMs are kept on disk (a version never changes), so a
# restart doesn't read them from OnShape again. Default: data/onshape-versions
# ONSHAPE_CACHE_DIR=/app/data/onshape-versions

# Interface to bind. Defaults to 127.0.0.1 (loopback only).
# In Docker, set HOST=0.0.0.0 and publish to loopback: -p 127.0.0.1:3000:3000
HOST=127.0.0.1

# ─── Authentication (Authentik, OIDC authorization-code flow + PKCE) ────────
# The gate FAILS CLOSED: with these unset, every request is refused with 503.
#
# In Authentik: create an OAuth2/OpenID provider, then an Application bound to
# it, then bind the students and mentors groups to that Application so anyone
# else is refused at sign-in. Add a Scope Mapping that emits the `groups` claim:
# the app checks it (TEAM_GROUPS and REQUIRE_GROUP below).
#
# OIDC_ISSUER is the provider URL, ending in /application/o/<app-slug>/
OIDC_ISSUER=https://auth.example.com/application/o/valorbom/
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Must match the Redirect URI configured on the Authentik provider exactly.
OIDC_REDIRECT_URI=https://bom.example.com/auth/callback
# Where Authentik sends the browser after sign-out (optional).
OIDC_POST_LOGOUT_REDIRECT=

# Signs the session cookie. Generate with: openssl rand -base64 48
# Changing it logs everyone out.
SESSION_SECRET=

# Who may use the app at all (the BOM tooling): members of any of these groups,
# comma-separated. The mentors group below is always included.
TEAM_GROUPS=Valor Students, Valor Mentors

# Who may use parts ordering and check-in (they move money and close tickets).
# Checked in the app; empty means "Valor Mentors".
REQUIRE_GROUP=Valor Mentors

# Local development only. Skips authentication entirely — and is IGNORED
# unless HOST is loopback, so it cannot accidentally expose a deployment.
AUTH_DEV_BYPASS=false

# Set true only for plain-HTTP loopback development, so the session cookie is
# sent without the Secure flag. Never set this on a deployment.
AUTH_COOKIE_INSECURE=false

# Optional: allow a cross-origin client. Unset means same-origin only, which is
# what the Vite dev proxy and the production build both use.
# CORS_ORIGIN=https://bom.example.com

# Jira
JIRA_URL=https://jira.example.com          # (alias: JIRA_BASE_URL)
JIRA_KEY=your_jira_personal_access_token
PROJECT_KEY=VAL                            # (alias: JIRA_PROJECT)

# Jira project holding purchase requests (the Part Orders board). Separate from
# PROJECT_KEY, which is the project the Assembly BOM flow writes manufactured
# parts into.
PARTS_PROJECT_KEY=PARTS

# Onshape
ONSHAPE_URL=https://cad.onshape.com        # (alias: ONSHAPE_BASE_URL)
ONSHAPE_ACCESS=your_onshape_access_key     # (alias: API_KEY)
ONSHAPE_SECRET=your_onshape_secret_key     # (alias: SECRET_KEY)
ONSHAPE_TEAM=your_team_id                  # (alias: ONSHAPE_TEAM_ID)

# Purchasing — the parts-order Google Sheet
# ORDER_SHEET_ID is the id from the sheet URL:
#   https://docs.google.com/spreadsheets/d/{ORDER_SHEET_ID}/edit
# GOOGLE_CREDENTIALS_PATH points at a Google service-account JSON key; the
# service account must be shared on the spreadsheet as an Editor.
ORDER_SHEET_ID=your_parts_order_spreadsheet_id
ORDER_SHEET_TAB=Orders
GOOGLE_CREDENTIALS_PATH=./keys.json

# How often to poll the Orders tab and advance any Jira ticket the purchaser
# has already moved on (Ordered / Delivered). Google Sheets cannot call out to
# this app, so this poll is how its edits reach Jira. Set to 0 to disable and
# rely on the Sync now button instead. Minimum 30000; default 300000 (5 min).
SHEET_SYNC_INTERVAL_MS=300000

# Test data (optional)
TEST_DOCUMENT_ID=
TEST_WORKSPACE_ID=
TEST_ELEMENT_ID=
