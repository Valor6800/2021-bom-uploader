# ValorBOM Environment Variables
# Copy this file to .env and fill in your values.
# (Legacy aliases in parentheses are still accepted for backward compatibility.)

PORT=3000

# Optional: restrict CORS to a specific origin (defaults to "*")
CORS_ORIGIN=*

# Jira
JIRA_URL=https://jira.example.com          # (alias: JIRA_BASE_URL)
JIRA_KEY=your_jira_personal_access_token
PROJECT_KEY=VAL                            # (alias: JIRA_PROJECT)

# Onshape
ONSHAPE_URL=https://cad.onshape.com        # (alias: ONSHAPE_BASE_URL)
ONSHAPE_ACCESS=your_onshape_access_key     # (alias: API_KEY)
ONSHAPE_SECRET=your_onshape_secret_key     # (alias: SECRET_KEY)
ONSHAPE_TEAM=your_team_id                  # (alias: ONSHAPE_TEAM_ID)

# Test data (optional)
TEST_DOCUMENT_ID=
TEST_WORKSPACE_ID=
TEST_ELEMENT_ID=
