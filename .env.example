# ValorBOM Environment Variables
# Copy this file to .env and fill in your values

PORT=3000

# Jira (accepts JIRA_URL or JIRA_BASE_URL)
JIRA_BASE_URL=https://jira.example.com
JIRA_KEY=your_jira_personal_access_token
PROJECT_KEY=VAL

# Onshape (accepts ONSHAPE_URL or ONSHAPE_BASE_URL)
ONSHAPE_BASE_URL=https://cad.onshape.com
API_KEY=your_onshape_api_key
SECRET_KEY=your_onshape_secret_key
ONSHAPE_TEAM_ID=your_team_id

# Test data (optional)
TEST_DOCUMENT_ID=
TEST_WORKSPACE_ID=
TEST_ELEMENT_ID=
