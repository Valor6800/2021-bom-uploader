{
  "name": "valorbom",
  "version": "2.0.0",
  "description": "BOM management tool bridging Onshape CAD assemblies with Jira project tracking",
  "type": "module",
  "main": "src/server/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server/index.js",
    "dev": "vite --config src/client/vite.config.js",
    "build": "vite build --config src/client/vite.config.js",
    "preview": "vite preview --config src/client/vite.config.js",
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest",
    "test:watch": "NODE_OPTIONS='--experimental-vm-modules' jest --watch",
    "test:coverage": "NODE_OPTIONS='--experimental-vm-modules' jest --coverage"
  },
  "author": "",
  "license": "Apache-2.0",
  "dependencies": {
    "@tanstack/react-query": "^5.64.1",
    "axios": "1.7.9",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "fast-csv": "^5.0.2",
    "google-auth-library": "^9.15.1",
    "google-spreadsheet": "^4.1.5",
    "jira.js": "^4.0.2",
    "multer": "^1.4.5-lts.1",
    "openid-client": "^6.8.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^6.30.6",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "fast-check": "^3.23.2",
    "jest": "^29.7.0",
    "jest-environment-node": "^29.7.0",
    "jest-mock": "^29.7.0",
    "supertest": "^7.0.0",
    "vite": "^6.0.7"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {},
    "collectCoverageFrom": [
      "src/server/**/*.js"
    ],
    "coverageDirectory": "coverage",
    "testRegex": "/__tests__/.*\\.test\\.js$",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/__tests__/mocks/",
      "/__tests__/setup.js"
    ]
  }
}
