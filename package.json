{
  "name": "2021bom",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:live": "cross-env ENABLE_LIVE_TESTS=true jest __tests__/ValorBOM.live.test.js",
    "pack": "browserify src/ValorBOM.js --standalone ValorBOM -o dist/ValorBOM.js"
  },
  "author": "",
  "license": "Apache-2.0",
  "dependencies": {
    "body-parser": "^1.19.0",
    "dotenv": "^10.0.0",
    "express": "^4.17.1",
    "fast-csv": "^4.3.6",
    "multer": "^1.4.3",
    "request": "^2.88.2"
  },
  "devDependencies": {
    "browserify": "^17.0.0",
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "jest-environment-node": "^29.7.0",
    "jest-mock": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/**/*.js"
    ],
    "coverageDirectory": "coverage",
    "setupFiles": [
      "./__tests__/setup.js"
    ],
    "testRegex": "/__tests__/.*\\.test\\.js$",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/__tests__/mocks/",
      "/__tests__/setup.js"
    ]
  }
}
